  "privacy": {
    "title": "\u0633\u064a\u0627\u0633\u0629 \u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629",
    "last_updated": "\u0622\u062e\u0631 \u062a\u062d\u062f\u064a\u062b: \u0645\u0627\u064a 2026",
    "intro": {
      "title": "\u0645\u0642\u062f\u0645\u0629",
      "content": "\u062e\u0632\u064a\u0646\u062a\u064a (\"Khazinti\") \u0647\u0648 \u062a\u0637\u0628\u064a\u0642 \u062c\u0648\u0627\u0644 \u0644\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0645\u0627\u0644\u064a\u0629 \u0627\u0644\u0634\u062e\u0635\u064a\u0629. \u0646\u062d\u0646 \u0645\u0644\u062a\u0632\u0645\u0648\u0646 \u0628\u062d\u0645\u0627\u064a\u0629 \u062e\u0635\u0648\u0635\u064a\u062a\u0643 \u0648\u0636\u0645\u0627\u0646 \u0623\u0645\u0627\u0646 \u0645\u0639\u0644\u0648\u0645\u0627\u062a\u0643 \u0627\u0644\u0634\u062e\u0635\u064a\u0629. \u062a\u0648\u0636\u062d \u0633\u064a\u0627\u0633\u0629 \u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629 \u0647\u0630\u0647 \u0643\u064a\u0641\u064a\u0629 \u062a\u0639\u0627\u0645\u0644\u0646\u0627 \u0645\u0639 \u0628\u064a\u0627\u0646\u0627\u062a\u0643 \u0639\u0646\u062f \u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0643 \u0644\u062a\u0637\u0628\u064a\u0642\u0646\u0627."
    },
    "data_collection": {
      "title": "\u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062a\u064a \u0646\u062c\u0645\u0639\u0647\u0627",
      "content": "\u062e\u0632\u064a\u0646\u062a\u064a \u0645\u0635\u0645\u0645 \u0628\u0647\u0646\u062f\u0633\u0629 \u0623\u0648\u0641\u0644\u0627\u064a\u0646 \u0623\u0648\u0644\u0627\u064b \u0648\u062e\u0635\u0648\u0635\u064a\u0629 \u0623\u0648\u0644\u0627\u064b. \u0625\u0644\u064a\u0643 \u0645\u0627 \u064a\u062c\u0628 \u0623\u0646 \u062a\u0639\u0631\u0641\u0647:",
      "items": [
        "\u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u0627\u0644\u064a\u0629: \u062c\u0645\u064a\u0639 \u0628\u064a\u0627\u0646\u0627\u062a\u0643 \u0627\u0644\u0645\u0627\u0644\u064a\u0629 (\u062d\u0633\u0627\u0628\u0627\u062a\u060c \u0645\u0639\u0627\u0645\u0644\u0627\u062a\u060c \u0645\u064a\u0632\u0627\u0646\u064a\u0627\u062a\u060c \u0641\u0626\u0627\u062a) \u0645\u062e\u0632\u0646\u0629 \u062d\u0635\u0631\u064a\u0627\u064b \u0639\u0644\u0649 \u062c\u0647\u0627\u0632\u0643 \u0641\u064a \u0642\u0627\u0639\u062f\u0629 \u0628\u064a\u0627\u0646\u0627\u062a SQLite \u0645\u062d\u0644\u064a\u0629.",
        "\u0644\u0627 \u062a\u062e\u0632\u064a\u0646 \u0639\u0644\u0649 \u0627\u0644\u0633\u064a\u0631\u0641\u0631: \u0646\u062d\u0646 \u0644\u0627 \u0646\u062c\u0645\u0639 \u0648\u0644\u0627 \u0646\u0646\u0642\u0644 \u0648\u0644\u0627 \u0646\u062e\u0632\u0646 \u0623\u064a\u0627\u064b \u0645\u0646 \u0628\u064a\u0627\u0646\u0627\u062a\u0643 \u0627\u0644\u0645\u0627\u0644\u064a\u0629 \u0639\u0644\u0649 \u0633\u064a\u0631\u0641\u0631\u0627\u062a \u062e\u0627\u0631\u062c\u064a\u0629.",
        "\u0644\u0627 \u062d\u0633\u0627\u0628 \u0645\u0637\u0644\u0648\u0628: \u0644\u0627 \u062a\u062d\u062a\u0627\u062c \u0644\u0625\u0646\u0634\u0627\u0621 \u062d\u0633\u0627\u0628 \u0623\u0648 \u062a\u0642\u062f\u064a\u0645 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0634\u062e\u0635\u064a\u0629 \u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u062e\u0632\u064a\u0646\u062a\u064a.",
        "\u0623\u0633\u0639\u0627\u0631 \u0627\u0644\u0635\u0631\u0641: \u0639\u0646\u062f \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0645\u064a\u0632\u0627\u062a \u0627\u0644\u0639\u0645\u0644\u0627\u062a \u0627\u0644\u0645\u062a\u0639\u062f\u062f\u0629\u060c \u064a\u062c\u0644\u0628 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0623\u0633\u0639\u0627\u0631 \u0627\u0644\u0635\u0631\u0641 \u0645\u0646 APIs \u062e\u0627\u0631\u062c\u064a\u0629 (Frankfurter API). \u0641\u0642\u0637 \u0632\u0648\u062c \u0627\u0644\u0639\u0645\u0644\u0627\u062a \u064a\u064f\u0631\u0633\u0644 \u2014 \u0644\u0627 \u0628\u064a\u0627\u0646\u0627\u062a \u0634\u062e\u0635\u064a\u0629.",
        "\u0644\u0627 \u062a\u062d\u0644\u064a\u0644\u0627\u062a: \u0646\u062d\u0646 \u0644\u0627 \u0646\u0633\u062a\u062e\u062f\u0645 \u0623\u064a \u062e\u062f\u0645\u0627\u062a \u062a\u062d\u0644\u064a\u0644 \u0623\u0648 \u062a\u062a\u0628\u0639 \u062f\u0627\u062e\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642."
      ]
    },
    "data_storage": {
      "title": "\u062a\u062e\u0632\u064a\u0646 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0648\u0627\u0644\u0623\u0645\u0627\u0646",
      "content": "\u0623\u0645\u0627\u0646 \u0628\u064a\u0627\u0646\u0627\u062a\u0643 \u0647\u0648 \u0623\u0648\u0644\u0648\u064a\u062a\u0646\u0627 \u0627\u0644\u0642\u0635\u0648\u0649:",
      "items": [
        "\u062c\u0645\u064a\u0639 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0645\u062e\u0632\u0646\u0629 \u0645\u062d\u0644\u064a\u0627\u064b \u0639\u0644\u0649 \u062c\u0647\u0627\u0632\u0643 \u0641\u064a \u0642\u0627\u0639\u062f\u0629 \u0628\u064a\u0627\u0646\u0627\u062a SQLite \u0645\u0634\u0641\u0631\u0629.",
        "\u0627\u0644\u0648\u0635\u0648\u0644 \u0644\u0644\u062a\u0637\u0628\u064a\u0642 \u0645\u062d\u0645\u064a \u0628\u0631\u0645\u0632 PIN \u0648/\u0623\u0648 \u0627\u0644\u0645\u0635\u0627\u062f\u0642\u0629 \u0627\u0644\u0628\u064a\u0648\u0645\u062a\u0631\u064a\u0629 (\u0628\u0635\u0645\u0629 \u0627\u0644\u0625\u0635\u0628\u0639\u060c \u0627\u0644\u062a\u0639\u0631\u0641 \u0639\u0644\u0649 \u0627\u0644\u0648\u062c\u0647).",
        "\u0644\u0627 \u062a\u064f\u0646\u0642\u0644 \u0623\u064a \u0628\u064a\u0627\u0646\u0627\u062a \u0625\u0644\u0649 \u0633\u064a\u0631\u0641\u0631\u0627\u062a\u0646\u0627 \u0623\u0648 \u0623\u064a \u0637\u0631\u0641 \u062b\u0627\u0644\u062b (\u0628\u0627\u0633\u062a\u062b\u0646\u0627\u0621 \u0637\u0644\u0628\u0627\u062a \u0623\u0633\u0639\u0627\u0631 \u0627\u0644\u0635\u0631\u0641 \u0627\u0644\u0645\u0630\u0643\u0648\u0631\u0629 \u0623\u0639\u0644\u0627\u0647).",
        "\u0625\u0630\u0627 \u062d\u0630\u0641\u062a \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u062a\u064f\u062d\u0630\u0641 \u062c\u0645\u064a\u0639 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0646\u0647\u0627\u0626\u064a\u0627\u064b \u0645\u0646 \u062c\u0647\u0627\u0632\u0643."
      ]
    },
    "third_party": {
      "title": "\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0637\u0631\u0641 \u0627\u0644\u062b\u0627\u0644\u062b",
      "content": "\u062e\u0632\u064a\u0646\u062a\u064a \u064a\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u062d\u062f \u0627\u0644\u0623\u062f\u0646\u0649 \u0645\u0646 \u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0637\u0631\u0641 \u0627\u0644\u062b\u0627\u0644\u062b:",
      "items": [
        "APIs \u0623\u0633\u0639\u0627\u0631 \u0627\u0644\u0635\u0631\u0641: Frankfurter API \u0648 Open Exchange Rates API \u062a\u064f\u0633\u062a\u062e\u062f\u0645 \u0641\u0642\u0637 \u0644\u062c\u0644\u0628 \u0623\u0633\u0639\u0627\u0631 \u0627\u0644\u0635\u0631\u0641 \u0627\u0644\u062d\u0627\u0644\u064a\u0629. \u0641\u0642\u0637 \u0631\u0645\u0648\u0632 \u0627\u0644\u0639\u0645\u0644\u0627\u062a \u062a\u064f\u0631\u0633\u0644 \u2014 \u0644\u0627 \u0628\u064a\u0627\u0646\u0627\u062a \u0634\u062e\u0635\u064a\u0629 \u0623\u0648 \u0645\u0627\u0644\u064a\u0629.",
        "App Store / Play Store: \u0627\u0644\u062a\u0648\u0632\u064a\u0639 \u0639\u0628\u0631 Apple App Store \u0648 Google Play Store \u064a\u062e\u0636\u0639 \u0644\u0633\u064a\u0627\u0633\u0627\u062a \u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0647\u0645.",
        "\u0644\u0627 \u0634\u0628\u0643\u0627\u062a \u0625\u0639\u0644\u0627\u0646\u064a\u0629\u060c \u0644\u0627 SDKs \u0644\u0648\u0633\u0627\u0626\u0644 \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639\u064a\u060c \u0648\u0644\u0627 \u0645\u0646\u0635\u0627\u062a \u062a\u062d\u0644\u064a\u0644 \u0645\u062f\u0645\u062c\u0629 \u0641\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642."
      ]
    },
    "user_rights": {
      "title": "\u062d\u0642\u0648\u0642\u0643",
      "content": "\u0628\u0645\u0627 \u0623\u0646 \u062c\u0645\u064a\u0639 \u0628\u064a\u0627\u0646\u0627\u062a\u0643 \u0645\u062e\u0632\u0646\u0629 \u0645\u062d\u0644\u064a\u0627\u064b \u0639\u0644\u0649 \u062c\u0647\u0627\u0632\u0643\u060c \u0644\u062f\u064a\u0643 \u062a\u062d\u0643\u0645 \u0643\u0627\u0645\u0644:",
      "items": [
        "\u0627\u0644\u0648\u0635\u0648\u0644: \u064a\u0645\u0643\u0646\u0643 \u0639\u0631\u0636 \u062c\u0645\u064a\u0639 \u0628\u064a\u0627\u0646\u0627\u062a\u0643 \u0645\u0628\u0627\u0634\u0631\u0629 \u0641\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0641\u064a \u0623\u064a \u0648\u0642\u062a.",
        "\u0627\u0644\u062d\u0630\u0641: \u064a\u0645\u0643\u0646\u0643 \u062d\u0630\u0641 \u0623\u064a \u0623\u0648 \u0643\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0645\u0646 \u062f\u0627\u062e\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0623\u0648 \u0628\u062d\u0630\u0641 \u0627\u0644\u062a\u0637\u0628\u064a\u0642.",
        "\u0627\u0644\u062a\u0635\u062f\u064a\u0631: \u064a\u0645\u0643\u0646\u0643 \u062a\u0635\u062f\u064a\u0631 \u0628\u064a\u0627\u0646\u0627\u062a\u0643 \u0628\u0635\u064a\u063a \u0642\u064a\u0627\u0633\u064a\u0629 \u0644\u0633\u062c\u0644\u0627\u062a\u0643 \u0627\u0644\u062e\u0627\u0635\u0629.",
        "\u0642\u0627\u0628\u0644\u064a\u0629 \u0627\u0644\u0646\u0642\u0644: \u0628\u064a\u0627\u0646\u0627\u062a\u0643 \u0645\u0644\u0643\u0643. \u0646\u062d\u0646 \u0644\u0627 \u0646\u0635\u0644 \u0625\u0644\u064a\u0647\u0627 \u0623\u0628\u062f\u0627\u064b."
      ]
    },
    "children": {
      "title": "\u062e\u0635\u0648\u0635\u064a\u0629 \u0627\u0644\u0623\u0637\u0641\u0627\u0644",
      "content": "\u062e\u0632\u064a\u0646\u062a\u064a \u063a\u064a\u0631 \u0645\u0648\u062c\u0647 \u0644\u0644\u0623\u0637\u0641\u0627\u0644 \u062f\u0648\u0646 13 \u0633\u0646\u0629. \u0646\u062d\u0646 \u0644\u0627 \u0646\u062c\u0645\u0639 \u0639\u0646 \u0639\u0644\u0645 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0634\u062e\u0635\u064a\u0629 \u0645\u0646 \u0627\u0644\u0623\u0637\u0641\u0627\u0644. \u0628\u0645\u0627 \u0623\u0646 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u064a\u0639\u0645\u0644 \u0628\u0627\u0644\u0643\u0627\u0645\u0644 \u0623\u0648\u0641\u0644\u0627\u064a\u0646 \u0628\u062f\u0648\u0646 \u062c\u0645\u0639 \u0628\u064a\u0627\u0646\u0627\u062a\u060c \u0644\u0627 \u062a\u0648\u062c\u062f \u0622\u0644\u064a\u0629 \u064a\u0645\u0643\u0646 \u0645\u0646 \u062e\u0644\u0627\u0644\u0647\u0627 \u062c\u0645\u0639 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0623\u0637\u0641\u0627\u0644."
    },
    "changes": {
      "title": "\u062a\u063a\u064a\u064a\u0631\u0627\u062a \u0639\u0644\u0649 \u0647\u0630\u0647 \u0627\u0644\u0633\u064a\u0627\u0633\u0629",
      "content": "\u0642\u062f \u0646\u062d\u062f\u0651\u062b \u0633\u064a\u0627\u0633\u0629 \u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629 \u0647\u0630\u0647 \u0645\u0646 \u0648\u0642\u062a \u0644\u0622\u062e\u0631. \u0623\u064a \u062a\u063a\u064a\u064a\u0631\u0627\u062a \u0633\u062a\u0646\u0639\u0643\u0633 \u0641\u064a \u062a\u0627\u0631\u064a\u062e \"\u0622\u062e\u0631 \u062a\u062d\u062f\u064a\u062b\" \u0641\u064a \u0623\u0639\u0644\u0649 \u0647\u0630\u0647 \u0627\u0644\u0635\u0641\u062d\u0629. \u0646\u0634\u062c\u0639\u0643 \u0639\u0644\u0649 \u0645\u0631\u0627\u062c\u0639\u0629 \u0647\u0630\u0647 \u0627\u0644\u0633\u064a\u0627\u0633\u0629 \u0628\u0634\u0643\u0644 \u062f\u0648\u0631\u064a."
    },
    "contact": {
      "title": "\u0627\u062a\u0635\u0644 \u0628\u0646\u0627",
      "content": "\u0625\u0630\u0627 \u0643\u0627\u0646 \u0644\u062f\u064a\u0643 \u0623\u064a \u0623\u0633\u0626\u0644\u0629 \u0623\u0648 \u0645\u062e\u0627\u0648\u0641 \u0628\u0634\u0623\u0646 \u0633\u064a\u0627\u0633\u0629 \u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629 \u0647\u0630\u0647 \u0623\u0648 \u0645\u0645\u0627\u0631\u0633\u0627\u062a\u0646\u0627 \u0641\u064a \u0627\u0644\u062a\u0639\u0627\u0645\u0644 \u0645\u0639 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a\u060c \u064a\u0631\u062c\u0649 \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0645\u0639\u0646\u0627 \u0639\u0644\u0649:",
      "email": "support.khazinti@gmail.com"
    }
